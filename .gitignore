data/raw/*
!data/raw/.gitkeep
data/warehouse/*
!data/warehouse/.gitkeep
data/exports/*
!data/exports/.gitkeep

# Keep the committed CI sample
!data/sample/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml
logs/

# Local pipeline state (watermark is persisted between runs via GitHub Releases)
pipeline/state/watermark.json

# Great Expectations local uncommitted bits
great_expectations/uncommitted/

# Oracle wallet (NEVER commit) and secrets
oracle/wallet/
*.env
.env

# OS
.DS_Store
